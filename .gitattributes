# Almost everything here is executed by Linux: shell scripts, systemd units,
# udev rules, Python. A CRLF line ending in any of them is not cosmetic - the
# kernel fails to find the interpreter and reports "bad interpreter: No such
# file or directory", which reads as a missing file rather than a broken one.
# Store and check out LF regardless of the platform the clone happens on.
* text=auto eol=lf

# PowerShell tooling runs on Windows, where CRLF is the native convention.
*.ps1 text eol=crlf

# Never touched.
*.png  binary
*.iso  binary
*.efi  binary
*.fd   binary
*.0    binary
*.c32  binary
