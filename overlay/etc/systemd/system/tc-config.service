[Unit]
Description=ThinClient configuration (boot media, central config, device settings)
After=local-fs.target NetworkManager.service
Wants=NetworkManager.service
Before=thinclient.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=-/usr/bin/timeout --kill-after=2 40 /usr/local/sbin/tc-fetch-config
ExecStart=/usr/bin/timeout --kill-after=2 45 /usr/local/sbin/tc-apply-config
TimeoutStartSec=95

[Install]
WantedBy=multi-user.target
