#!/bin/sh
# Re-read central configuration whenever a link comes up. This is what makes a
# PXE client that booted before DHCP finished still pick up its server list.
IFACE="$1"
ACTION="$2"

case "$ACTION" in
    up|dhcp4-change) ;;
    *) exit 0 ;;
esac

[ "$IFACE" = "lo" ] && exit 0
mkdir -p /run/thinclient

# DHCP option 224 carries the configuration URL, the same idea as a Wyse unit
# being pointed at its wnos.ini by the DHCP server.
for candidate in "${DHCP4_PRIVATE_224:-}" "${DHCP4_OPTION_224:-}" "${DHCP4_TC_CONFIG:-}"; do
    case "$candidate" in
        http://*|https://*)
            printf '%s' "$candidate" > /run/thinclient/dhcp-config-url
            break
            ;;
    esac
done

/usr/local/sbin/tc-fetch-config >/dev/null 2>&1
/usr/local/sbin/tc-apply-config >/dev/null 2>&1

# Tell a running connection manager to reload its list.
pkill -HUP -f '/usr/local/lib/thinclient/manager.py' 2>/dev/null

exit 0
