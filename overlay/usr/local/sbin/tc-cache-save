#!/bin/sh
# Save a network-fetched squashfs to a dedicated removable USB cache.
set -u

CMDLINE_FILE="${TC_CACHE_CMDLINE_FILE:-/proc/cmdline}"
STATUS_FILE="${TC_CACHE_STATUS_FILE:-/run/initramfs/tc-cache-status}"
LIVE_MEDIUM="${TC_CACHE_LIVE_MEDIUM:-/run/live/medium}"
CACHE_MOUNT="${TC_CACHE_MOUNT_DIR:-/run/thinclient/cache-media}"
MOUNTED=0
TEMP_FILE=""

log() { echo "tc-cache-save: $*"; }
cleanup() {
    [ -z "$TEMP_FILE" ] || rm -f -- "$TEMP_FILE"
    [ "$MOUNTED" -eq 0 ] || umount "$CACHE_MOUNT" 2>/dev/null || true
}
trap cleanup EXIT HUP INT TERM

arg() {
    key="$1"
    for parameter in $(cat "$CMDLINE_FILE" 2>/dev/null); do
        case "$parameter" in "${key}"=*) printf '%s\n' "${parameter#*=}"; return 0 ;; esac
    done
    return 1
}

[ "$(arg tc.cache 2>/dev/null || true)" = "1" ] || exit 0
PROFILE="$(arg tc.cache.profile 2>/dev/null || true)"
EXPECTED="$(arg tc.cache.sha256 2>/dev/null || true)"
LABEL="$(arg tc.cache.label 2>/dev/null || echo TCCACHE)"
FETCH_URL="$(arg fetch 2>/dev/null || true)"
EXPECTED="$(printf '%s' "$EXPECTED" | tr 'A-F' 'a-f')"

printf '%s' "$PROFILE" | grep -Eq '^[A-Za-z0-9._-]{1,32}$' || { log "invalid profile"; exit 1; }
printf '%s' "$LABEL" | grep -Eq '^[A-Za-z0-9._-]{1,32}$' || { log "invalid label"; exit 1; }
printf '%s' "$EXPECTED" | grep -Eq '^[0-9a-f]{64}$' || { log "invalid checksum"; exit 1; }
[ -n "$FETCH_URL" ] || { log "fetch URL is missing"; exit 1; }

# A cache hit needs no write. A network result is saved in the background once
# the normal boot is already usable.
STATE="$(sed -n 's/^state=//p' "$STATUS_FILE" 2>/dev/null | head -1)"
[ "$STATE" != hit ] || { log "$PROFILE cache hit"; exit 0; }
SOURCE="$LIVE_MEDIUM/live/$(basename "$FETCH_URL")"
[ -f "$SOURCE" ] || { log "downloaded squashfs is not available at $SOURCE"; exit 1; }

is_usb() {
    udevadm info --query=property --name="$1" 2>/dev/null | grep -qx 'ID_BUS=usb'
}

mkdir -p "$CACHE_MOUNT"
chmod 0700 "$CACHE_MOUNT"
udevadm settle --timeout=5 2>/dev/null || true

for DEVICE in $(blkid -t "LABEL=$LABEL" -o device 2>/dev/null | sort -u); do
    is_usb "$DEVICE" || continue
    FSTYPE="$(blkid -s TYPE -o value "$DEVICE" 2>/dev/null || true)"
    case "$FSTYPE" in
        vfat) OPTIONS="rw,nosuid,nodev,noexec,noatime,flush,umask=0077" ;;
        exfat|ext4) OPTIONS="rw,nosuid,nodev,noexec,noatime" ;;
        *) continue ;;
    esac
    mount -t "$FSTYPE" -o "$OPTIONS" "$DEVICE" "$CACHE_MOUNT" 2>/dev/null || continue
    MOUNTED=1

    CACHE_ROOT="$CACHE_MOUNT/thinclient-cache"
    CACHE_DIR="$CACHE_ROOT/$PROFILE"
    [ ! -L "$CACHE_ROOT" ] && [ ! -L "$CACHE_DIR" ] || {
        log "refusing symlinked cache directory on $DEVICE"
        exit 1
    }
    mkdir -p "$CACHE_DIR" || exit 1
    chmod 0700 "$CACHE_ROOT" "$CACHE_DIR" 2>/dev/null || true
    TARGET="$CACHE_DIR/$EXPECTED.squashfs"

    if [ -f "$TARGET" ] && [ "$(sha256sum "$TARGET" | sed 's/[[:space:]].*$//')" = "$EXPECTED" ]; then
        log "$PROFILE is already cached on $DEVICE"
        exit 0
    fi

    TEMP_FILE="$(mktemp "$CACHE_DIR/.${EXPECTED}.part.XXXXXX")" || exit 1
    log "saving $PROFILE to $DEVICE"
    ACTUAL="$(tee "$TEMP_FILE" < "$SOURCE" | sha256sum | sed 's/[[:space:]].*$//')"
    if [ "$ACTUAL" != "$EXPECTED" ]; then
        log "downloaded squashfs checksum mismatch; cache was not changed"
        exit 1
    fi
    chmod 0400 "$TEMP_FILE" 2>/dev/null || true
    sync -f "$TEMP_FILE" 2>/dev/null || sync
    mv -f -- "$TEMP_FILE" "$TARGET" || exit 1
    TEMP_FILE=""
    sync -f "$CACHE_DIR" 2>/dev/null || sync

    # The PXE server remains the rollback source, so retain only the currently
    # advertised version and prevent a small USB from filling over time.
    for OLD in "$CACHE_DIR"/*.squashfs; do
        [ -e "$OLD" ] || continue
        [ "$OLD" = "$TARGET" ] && continue
        OLD_NAME="$(basename "$OLD")"
        printf '%s' "$OLD_NAME" | grep -Eq '^[0-9a-f]{64}\.squashfs$' || continue
        rm -f -- "$OLD"
    done

    mkdir -p /run/thinclient
    printf 'saved %s %s %s\n' "$PROFILE" "$EXPECTED" "$DEVICE" \
        > /run/thinclient/cache-status
    log "$PROFILE cache saved and verified"
    exit 0
done

log "no writable removable USB partition labelled $LABEL"
exit 0
