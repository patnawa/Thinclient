#!/bin/sh
# Unattended installation, driven entirely by the kernel command line.
#
#   tc.install.auto=1 tc.install.target=/dev/sda [tc.install.reboot=1]
#
# Netboot a room full of machines with these arguments and each one installs
# itself to its own disk and reboots. Nobody has to sit in front of them.
#
# Deliberately noisy on the console: this is destructive and unattended, so the
# only record of what happened is what it prints.
set -u

exec >/dev/console 2>&1

kernel_arg() {
    for word in $(cat /proc/cmdline); do
        case "$word" in "$1"=*) echo "${word#*=}"; return 0 ;; esac
    done
    return 1
}

TARGET="$(kernel_arg tc.install.target || true)"

echo
echo "=================== ThinClient unattended install ==================="

if [ -z "${TARGET:-}" ]; then
    echo "tc.install.target= was not given; nothing to do."
    echo "Available disks:"
    /usr/local/sbin/tc-install --list
    echo "TC_INSTALL_EXIT=64"
    exit 0
fi

echo "target: $TARGET"
/usr/local/sbin/tc-install --target "$TARGET" --yes
STATUS=$?

# A single greppable line, so an automated run can tell success from failure
# without parsing prose.
echo "TC_INSTALL_EXIT=$STATUS"

if [ "$STATUS" -eq 0 ] && [ "$(kernel_arg tc.install.reboot || echo 0)" = "1" ]; then
    echo "rebooting into the installed system"
    sleep 3
    systemctl reboot
fi

echo "====================================================================="
exit 0
