#!/bin/sh
# Persist the configuration handed to us on stdin onto the TCCONF partition.
# Exits non-zero (with a reason on stderr) when there is nowhere to write, which
# the UI reports as "saved for this session only".
set -u

RUN=/run/thinclient
MEDIA="$RUN/media"
ROOT_STATE="$RUN/.root"
TMP=""
MEDIA_TMP=""

# $RUN is group-writable by design.  A fixed root-written filename there lets
# the kiosk user redirect `cat > file` through a symlink to any root-writable
# path.  All scratch data therefore lives below a verified root-only directory.
ensure_root_state() {
    if mkdir -m 0700 "$ROOT_STATE" 2>/dev/null; then
        :
    elif [ -L "$ROOT_STATE" ] || [ ! -d "$ROOT_STATE" ]; then
        echo "unsafe runtime state path: $ROOT_STATE" >&2
        return 1
    fi
    [ ! -L "$ROOT_STATE" ] \
        && [ "$(stat -c '%u:%a' "$ROOT_STATE" 2>/dev/null)" = "0:700" ] || {
        echo "$ROOT_STATE is not a root-only directory" >&2
        return 1
    }
}

cleanup() {
    [ -z "$TMP" ] || rm -f -- "$TMP"
    [ -z "$MEDIA_TMP" ] || rm -f -- "$MEDIA_TMP"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

ensure_root_state || exit 5
TMP="$(mktemp "$ROOT_STATE/save.XXXXXX")" || {
    echo "could not create a private configuration file" >&2
    exit 5
}

cat > "$TMP" || {
    echo "could not read configuration" >&2
    exit 2
}
if ! python3 -c 'import json,sys; json.load(open(sys.argv[1]))' "$TMP" 2>/dev/null; then
    echo "refusing to save invalid JSON" >&2
    exit 2
fi

# BEGIN TCCONF_DEVICE_RESOLVER
# Keep this resolver identical in both configuration scripts. A label can occur
# on more than one attached drive, so never let blkid choose an arbitrary one.
tcconf_labelled_device() {
    [ -n "${1:-}" ] \
        && [ "$(blkid -s LABEL -o value "$1" 2>/dev/null)" = "TCCONF" ] \
        && [ "$(blkid -s TYPE -o value "$1" 2>/dev/null)" = "vfat" ]
}

tcconf_canonical_device() {
    tc_resolved="$(readlink -f "$1" 2>/dev/null || true)"
    if [ -n "$tc_resolved" ]; then
        printf '%s\n' "$tc_resolved"
    else
        printf '%s\n' "$1"
    fi
}

tcconf_mounted_device() {
    tc_source="$(findmnt -rn -o SOURCE --target "$1" 2>/dev/null | sed -n '1p')"
    [ -n "$tc_source" ] && tcconf_labelled_device "$tc_source" || return 1
    tcconf_canonical_device "$tc_source"
}

tcconf_whole_disk() {
    tc_current="$(tcconf_canonical_device "$1")"
    tc_hops=0
    while [ "$tc_hops" -lt 16 ]; do
        tc_parent="$(lsblk -dnro PKNAME "$tc_current" 2>/dev/null | sed -n '1p')"
        if [ -z "$tc_parent" ]; then
            printf '%s\n' "$tc_current"
            return 0
        fi
        case "$tc_parent" in
            /*) tc_current="$tc_parent" ;;
            *)  tc_current="/dev/$tc_parent" ;;
        esac
        tc_current="$(tcconf_canonical_device "$tc_current")"
        tc_hops=$((tc_hops + 1))
    done
    return 1
}

tcconf_discover_device() {
    tc_candidates="$(blkid -t LABEL=TCCONF -o device 2>/dev/null || true)"
    [ -n "$tc_candidates" ] || return 1

    tc_boot_source="$(findmnt -rn -o SOURCE --target /run/live/medium 2>/dev/null | sed -n '1p')"
    tc_boot_disk=""
    if [ -n "$tc_boot_source" ]; then
        tc_boot_disk="$(tcconf_whole_disk "$tc_boot_source" 2>/dev/null || true)"
    fi

    tc_fallback=""
    for tc_candidate in $tc_candidates; do
        tcconf_labelled_device "$tc_candidate" || continue
        tc_candidate="$(tcconf_canonical_device "$tc_candidate")"
        [ -n "$tc_fallback" ] || tc_fallback="$tc_candidate"
        if [ -n "$tc_boot_disk" ] \
                && [ "$(tcconf_whole_disk "$tc_candidate" 2>/dev/null || true)" = "$tc_boot_disk" ]; then
            printf '%s\n' "$tc_candidate"
            return 0
        fi
    done

    [ -n "$tc_fallback" ] || return 1
    printf '%s\n' "$tc_fallback"
}

tcconf_mount_options() {
    tc_mode="$1"
    tc_device="$2"
    [ "$(blkid -s TYPE -o value "$tc_device" 2>/dev/null)" = "vfat" ] || return 1
    # FAT has no Unix ownership or mode bits. These masks make config, CA files,
    # support keys, and host private keys root-only while the UI continues to
    # read/write config through its sudo helpers.
    printf '%s\n' "$tc_mode,noatime,nosuid,nodev,noexec,uid=0,gid=0,fmask=0177,dmask=0077"
}

tcconf_secure_mount() {
    tc_mode="$1" tc_device="$2" tc_target="$3"
    tc_options="$(tcconf_mount_options "$tc_mode" "$tc_device")" || return 1
    mount -o "$tc_options" "$tc_device" "$tc_target"
}

tcconf_secure_remount() {
    tc_mode="$1" tc_device="$2" tc_target="$3"
    tc_options="$(tcconf_mount_options "$tc_mode" "$tc_device")" || return 1
    mount -o "remount,$tc_options" "$tc_target"
}
# END TCCONF_DEVICE_RESOLVER

if mountpoint -q "$MEDIA"; then
    # Once mounted, this source is authoritative. Do not switch to a different
    # same-labelled device merely because blkid happens to list it first.
    DEV="$(tcconf_mounted_device "$MEDIA" 2>/dev/null || true)"
    if [ -z "$DEV" ]; then
        echo "$MEDIA is not mounted from a TCCONF partition" >&2
        exit 4
    fi
else
    DEV="$(tcconf_discover_device 2>/dev/null || true)"
    if [ -z "$DEV" ]; then
        echo "no TCCONF partition on this device" >&2
        exit 3
    fi
    # Honour a mount that appeared after discovery instead of covering it.
    if mountpoint -q "$MEDIA"; then
        DEV="$(tcconf_mounted_device "$MEDIA" 2>/dev/null || true)"
        if [ -z "$DEV" ]; then
            echo "$MEDIA is not mounted from a TCCONF partition" >&2
            exit 4
        fi
    elif ! tcconf_secure_mount rw "$DEV" "$MEDIA" 2>/dev/null; then
        echo "could not mount the TCCONF partition read-write" >&2
        exit 4
    fi
fi
if ! tcconf_secure_remount rw "$DEV" "$MEDIA" 2>/dev/null; then
    echo "could not secure the TCCONF partition read-write" >&2
    exit 4
fi

# Create the replacement on the TCCONF filesystem itself, validate the copied
# bytes, then rename it over config.json.  mktemp uses O_EXCL, and rename
# replaces a hostile destination symlink rather than following it.
MEDIA_TMP="$(mktemp "$MEDIA/.config.json.XXXXXX")" || {
    echo "could not create a temporary file on the TCCONF partition" >&2
    exit 4
}
if ! cp -- "$TMP" "$MEDIA_TMP" || ! python3 -c \
        'import json,sys; json.load(open(sys.argv[1]))' "$MEDIA_TMP" 2>/dev/null \
        || ! chmod 0644 "$MEDIA_TMP" 2>/dev/null \
        || ! mv -fT -- "$MEDIA_TMP" "$MEDIA/config.json"; then
    echo "could not publish config.json on the TCCONF partition" >&2
    exit 4
fi
MEDIA_TMP=""
sync

# $ROOT_STATE and $RUN are on the same tmpfs, so this is an atomic publish of a
# root-owned, kiosk-readable layer even if media-config.json was a symlink.
if chmod 0644 "$TMP" && mv -fT -- "$TMP" "$RUN/media-config.json"; then
    TMP=""
else
    echo "warning: saved persistently but could not refresh the runtime copy" >&2
fi
echo "saved to $DEV"
