# Absolute path to the generated ThinClient PXE tree on the Debian host.
PXE_ROOT=/srv/thinclient/pxe

# Static LAN address on which TFTP and HTTP listen.
PXE_LISTEN=192.168.1.20

# TCP port used for vmlinuz, initrd, filesystem.squashfs, and config.json.
HTTP_PORT=8080

# Host syslog socket that receives the TFTP request log (journalctl -t in.tftpd).
# Debian with systemd provides /dev/log; point this at the socket of another
# syslog daemon if the host has no /dev/log.
# TFTP_SYSLOG_SOCKET=/dev/log

# Optional: omit this to build locally, or use the published GHCR image.
# PXE_IMAGE=ghcr.io/patnawa/thinclient-pxe-server:1.4.1
